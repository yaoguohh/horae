# horae recipe example. Copy to ~/.config/horae/recipes.toml and edit.
#
# Fields: see docs/design.md. cadence / timeout use s/m/h/d/w (e.g. 3h, 1d, 7d).
# `command` (argv array, no shell) and `shell` (for && / pipes) are mutually exclusive.
# `enabled` defaults true; `env` adds / overrides environment variables.
# Bare commands resolve against the injected PATH (includes /opt/homebrew/bin); for a
# binary outside standard dirs, use an absolute path or set the step's env.PATH.

[defaults]
timeout = "15m"
notify  = "on_change"  # always | never | on_change | on_failure

# Homebrew formulae (CLI tools): refresh metadata, upgrade formulae, clean up.
# HOMEBREW_FORCE_BREWED_CURL=1 uses brew's own curl (OpenSSL/nghttp2) to dodge the
# system curl HTTP/2 "stream not closed cleanly: PROTOCOL_ERROR" on flaky networks.
[[step]]
id      = "brew"
label   = "Homebrew"
cadence = "3h"
timeout = "15m"
shell   = "export HOMEBREW_FORCE_BREWED_CURL=1 HOMEBREW_NO_AUTO_UPDATE=1; brew update && brew upgrade --formula && brew cleanup -s"

# Homebrew casks (GUI apps): large downloads over vendor CDNs are slow and flaky, so
# run them as a separate low-frequency task that tolerates failure (|| true) and never
# blocks the formula step. CURL_RETRIES=1 makes a stuck download fail fast.
[[step]]
id      = "brew-cask"
label   = "Homebrew Cask"
cadence = "1d"
timeout = "20m"
shell   = "export HOMEBREW_FORCE_BREWED_CURL=1 HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_CURL_RETRIES=1; brew upgrade --cask || true"

# Global npm packages + native-CLI health gate.
#
# WARNING: some global CLIs (e.g. @anthropic-ai/claude-code, @openai/codex) ship their
# real ~200MB binary as a platform-specific optionalDependency. npm treats an optional
# dep that fails to download as NON-FATAL: it omits it and still EXITS 0, leaving a
# broken placeholder stub. So `npm update -g` can "succeed" (exit 0) while the tool is
# actually broken -- and an orchestrator that trusts the exit code never notices. The real
# enemy is a flaky/truncated download of the big tarball (the mirror DOES carry it); npm's
# default 2 retries give up fast and, being optional, it is silently dropped.
# Defend in three layers:
#  (1) raise fetch-retries + timeouts (env below) so the first `npm update -g` rides through
#      transient resets and finishes the ~200MB download itself;
#  (2) after updating, ASSERT each fragile CLI runs (`<bin> --version`); on failure self-heal:
#      `npm cache verify` (drop partials) -> CLEAN install `@latest --include=optional` (not
#      update-in-place; npm is unreliable resolving platform optional deps in place) -> then
#      install the platform package BY NAME (`<pkg>-<platform>@<version>`), which makes it a
#      REQUIRED dep (failure becomes fatal + retried + integrity-checked, instead of silently
#      omitted) -> run install.cjs to copy the binary over the stub; official registry first,
#      mirror as fallback;
#  (3) if still broken `exit 1` so the step fails loudly (-> Horae records failure + notifies).
# Never trust npm's exit code for these packages; `<bin> --version` is the only honest signal.
#
# If npm / node aren't on the launchd PATH (custom prefix like ~/.npm-global), add it via
# the step's env.PATH (see below).
[[step]]
id      = "npm"
label   = "npm globals"
cadence = "3h"
timeout = "40m"
shell   = 'npx npm-check-updates -g -u && npm update -g; rc=0; R=$(npm root -g); PLAT=$(node -p "process.platform+\"-\"+process.arch" 2>/dev/null); for s in "@anthropic-ai/claude-code|claude" "@openai/codex|codex"; do pkg=${s%%|*}; bin=${s##*|}; "$bin" --version >/dev/null 2>&1 && continue; echo "[horae] $bin broken, self-healing"; cjs="$R/$pkg/install.cjs"; [ -f "$cjs" ] && node "$cjs" >/dev/null 2>&1; "$bin" --version >/dev/null 2>&1 && continue; npm cache verify >/dev/null 2>&1 || true; for reg in https://registry.npmjs.org https://registry.npmmirror.com; do echo "[horae] reinstalling $pkg from $reg (clean + explicit platform pkg)"; npm install -g "$pkg@latest" --include=optional --foreground-scripts --registry="$reg" || true; VER=$(node -p "require(\"$R/$pkg/package.json\").version" 2>/dev/null); [ -n "$VER" ] && npm install -g "$pkg-$PLAT@$VER" --foreground-scripts --registry="$reg" || true; [ -f "$cjs" ] && node "$cjs" || true; "$bin" --version >/dev/null 2>&1 && break; done; "$bin" --version >/dev/null 2>&1 || { echo "[horae] $bin still broken" >&2; rc=1; }; done; exit $rc'

[step.env]
# Big native tarballs (~200MB) over a slow/flaky link drop as a "failed optional dep" when
# npm's default 2 retries / short timeouts give up. Raise them so the download rides through
# transient resets and finishes.
npm_config_fetch_retries = "8"
npm_config_fetch_retry_mintimeout = "20000"
npm_config_fetch_retry_maxtimeout = "600000"
npm_config_fetch_timeout = "1200000"
# Custom npm prefix? Inject its bin dir (uncomment + edit):
# PATH = "/Users/<you>/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

# Disabled template: flip `enabled` to true to use. Use an absolute path if the
# binary isn't on the injected PATH.
[[step]]
id      = "pipx"
label   = "pipx apps"
cadence = "1d"
command = ["pipx", "upgrade-all"]
enabled = false
