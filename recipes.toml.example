# horae recipe example. Copy to ~/.config/horae/recipes.toml and edit.
#
# Fields: see docs/design.md. cadence / timeout use s/m/h/d/w (e.g. 3h, 1d, 7d).
# `command` (argv array, no shell) and `shell` (for && / pipes) are mutually exclusive.
# `enabled` defaults true; `env` adds / overrides environment variables.
# Bare commands resolve against the injected PATH (includes /opt/homebrew/bin); for a
# binary outside standard dirs, use an absolute path or set the step's env.PATH.

[defaults]
timeout = "15m"
notify  = "on_change"  # always | never | on_change | on_failure

# Homebrew formulae (CLI tools): refresh metadata, upgrade formulae, clean up.
# HOMEBREW_FORCE_BREWED_CURL=1 uses brew's own curl (OpenSSL/nghttp2) to dodge the
# system curl HTTP/2 "stream not closed cleanly: PROTOCOL_ERROR" on flaky networks.
[[step]]
id      = "brew"
label   = "Homebrew"
cadence = "3h"
timeout = "15m"
shell   = "export HOMEBREW_FORCE_BREWED_CURL=1 HOMEBREW_NO_AUTO_UPDATE=1; brew update && brew upgrade --formula && brew cleanup -s"

# Homebrew casks (GUI apps): large downloads over vendor CDNs are slow and flaky, so
# run them as a separate low-frequency task that tolerates failure (|| true) and never
# blocks the formula step. CURL_RETRIES=1 makes a stuck download fail fast.
[[step]]
id      = "brew-cask"
label   = "Homebrew Cask"
cadence = "1d"
timeout = "20m"
shell   = "export HOMEBREW_FORCE_BREWED_CURL=1 HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_CURL_RETRIES=1; brew upgrade --cask || true"

# Global npm packages + native-CLI health gate.
#
# WARNING: some global CLIs (e.g. @anthropic-ai/claude-code, @openai/codex) ship their
# real ~200MB binary as a platform-specific optionalDependency. npm treats an optional
# dep that fails to download as NON-FATAL: it omits it and still EXITS 0, leaving a
# broken placeholder stub. So `npm update -g` can "succeed" (exit 0) while the tool is
# actually broken -- and an orchestrator that trusts the exit code never notices. The
# usual trigger is a slow mirror's lazy first-fetch of the big tarball exceeding npm's
# 5-min fetch-timeout. Defend in two layers: (1) raise fetch-timeout so the big tarball
# lands; (2) after updating, ASSERT each fragile CLI actually runs (`<bin> --version`);
# on failure clean-reinstall to self-heal, and if still broken `exit 1` so the step fails
# loudly (-> Horae records failure and notifies). Never trust npm's exit code here.
#
# If npm / node aren't on the launchd PATH (custom prefix like ~/.npm-global), add it via
# the step's env.PATH (see below).
[[step]]
id      = "npm"
label   = "npm globals"
cadence = "3h"
timeout = "40m"
shell   = 'npx npm-check-updates -g -u && npm update -g; rc=0; R=$(npm root -g); for s in "@anthropic-ai/claude-code|claude" "@openai/codex|codex"; do pkg=${s%%|*}; bin=${s##*|}; "$bin" --version >/dev/null 2>&1 && continue; echo "[horae] $bin broken, self-healing"; npm install -g "$pkg@latest" --foreground-scripts || true; cjs="$R/$pkg/install.cjs"; [ -f "$cjs" ] && node "$cjs" || true; "$bin" --version >/dev/null 2>&1 || { echo "[horae] $bin still broken" >&2; rc=1; }; done; exit $rc'

[step.env]
# Big native tarballs (~200MB) on a cold mirror can take 10-12 min; npm's default 5-min
# fetch-timeout would drop them as a failed optional dep. Raise it so they finish.
npm_config_fetch_timeout = "1200000"
# Custom npm prefix? Inject its bin dir (uncomment + edit):
# PATH = "/Users/<you>/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

# Disabled template: flip `enabled` to true to use. Use an absolute path if the
# binary isn't on the injected PATH.
[[step]]
id      = "pipx"
label   = "pipx apps"
cadence = "1d"
command = ["pipx", "upgrade-all"]
enabled = false
